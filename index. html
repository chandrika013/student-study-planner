<!DOCTYPE html>
<html>
<head>
    <title>Student Study Planner</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <h1>📚 Student Study Planner</h1>

    <p>Plan your studies and keep track of your tasks.</p>

    <input type="text" id="taskInput" placeholder="Enter your study task">
    
    <input type="date" id="dateInput">

    <button onclick="addTask()">Add Task</button>

    <h2>My Tasks</h2>

    <ul id="taskList"></ul>

    <script>
        function addTask() {
            let task = document.getElementById("taskInput").value;
            let date = document.getElementById("dateInput").value;

            if (task === "") {
                alert("Please enter a task");
                return;
            }

            if (date === "") {
                alert("Please select a due date");
                return;
            }

            let li = document.createElement("li");

            li.innerHTML =
                "<span>" + task + " - Due: " + date + "</span>" +
                " <button onclick='completeTask(this)'>Completed</button>" +
                " <button onclick='this.parentElement.remove()'>Delete</button>";

            document.getElementById("taskList").appendChild(li);

            document.getElementById("taskInput").value = "";
            document.getElementById("dateInput").value = "";
        }

        function completeTask(button) {
            let task = button.parentElement.querySelector("span");

            task.style.textDecoration = "line-through";

            button.innerText = "Completed ✓";
            button.disabled = true;
        }
    </script>

</body>
</html>
